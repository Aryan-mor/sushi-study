# Copy to .env and fill in. Never commit a filled .env.
# Lists use '|' between fields and ',' between entries. Bot tokens contain ':', so ':' never separates.
# Every name below is an example. Use your own bots and channels.

# testing: no new users unless an admin authorizes their Telegram ID under /admin. public: anyone.
SUSHI_ACCESS_MODE=testing
SUSHI_ENV=dev

# Numeric Telegram IDs, comma separated. Set at least one superadmin, or nobody can authorize users.
SUPERADMIN_IDS=
ADMIN_IDS=

# Databases, from the README's setup steps.
DATABASE_URL=postgres://sushi_app:CHANGE_ME@127.0.0.1:5434/sushi_dev?sslmode=disable
LIBRARY_DATABASE_URL=postgres://sushi_app:CHANGE_ME@127.0.0.1:5434/sushi_library?sslmode=disable

# exampleMainBot|123:token
MAIN_BOTS=
# exampleInitBot|123:token
INIT_BOTS=
# exampleApi01Bot|123:token,exampleApi02Bot|456:token
API_BOTS=
# exampleDelivery01Bot|123:token,exampleDelivery02Bot|456:token
DELIVERY_BOTS=
# exampleCatalogBot|123:token
CATALOG_BOT=
# exampleBackup01Bot|123:token|-1001111111111
BACKUP_BOTS=

# exampleLoginChannel|-1002222222222
LOGIN_POST_CHANNEL=
# clone|-1003333333333,backup1|-1001111111111,personal_clone|-1004444444444,personal_backup|-1005555555555
CHANNELS=
# Optional: where app builds are posted. exampleAppChannel|-1006666666666
RELEASE_CHANNEL=

# The handle of your support account or bot.
SUPPORT_BOT_USERNAME=exampleSupportBot

# Titles and posters.
TMDB_API_KEY=

# Seals stored bot tokens. Required outside dev. Create with: openssl rand -hex 32
SUSHI_SECRET_KEY=

# Abuse limits per person, for apid. Defaults are 30 and 2.
DELIVERY_RATE_PER_HOUR=
DELIVERY_MAX_CONCURRENT=
